# GioviSpecs 0.55

Foo<a Int, b Int, c Int>
Bar<x Int, y Int, z Foo>

"-------------------------------------------------------------------------------" -> _out
"iterating over range: 1..3" -> _out

"...with placeholder" -> _out
for _ in 1..3 do "_" -> _out

"...with unary" -> _out
for i in 1..3 do i -> _out

# "...with unary typed" -> _out
# for i Int in 1..3 do i -> _out

"-------------------------------------------------------------------------------" -> _out
list [Int] <- [1 2 3]
"iterating list: $list" -> _out

"...with placeholder" -> _out
for _ in list do "_" -> _out

"...with unary iterator" -> _out
for i in list do i -> _out

# "...with unary typed" -> _out
# for i Int in list do i -> _out

"-------------------------------------------------------------------------------" -> _out
listOfStruct [Foo] <- [
	Foo.<1,   2,   3>,
	Foo.<10,  20,  30>,
	Foo.<100, 200, 300>,
]
"iterating list of Struct: $listOfStruct" -> _out

"...with <a b c>" -> _out
for <a, b, c> in listOfStruct do "<$a $b $c>" -> _out

"...with s <a b c>" -> _out
for s <a, b, c> in listOfStruct do "$s <$a $b $c>" -> _out

# "...with <a typed, b typed, c typed>" -> _out
# for <a Int, b Int, c Int> in listOfStruct do "<$a $b $c>" -> _out

# "...with s typed <a typed, b typed, c typed>" -> _out
# for s Int <a Int, b Int, c Int> in listOfStruct do "$s <$a $b $c>" -> _out

"...with <.b, .a, .c>" -> _out
for <.b, .a, .c> in listOfStruct do "<$a $b $c>" -> _out

"-------------------------------------------------------------------------------" -> _out
listOfNestedStruct [Bar] <- [
	Bar.<1,   2,   Foo.<3,   4,   5>>,
	Bar.<10,  20,  Foo.<30,  40,  50>>,
	Bar.<100, 200, Foo.<300, 400, 500>>,
]
"iterating list of nested struct: $listOfNestedStruct" -> _out

"...with <x y <a b c>>" -> _out
for <x, y, z <a, b, c>> in listOfNestedStruct do "<$x $y $z <$a $b $c>>" -> _out

"...with <.y, .z <.b, .a, .c>, .x>" -> _out
for <.y, .z <.b, .a, .c>, .x> in listOfNestedStruct do "<$x $y $z <$a $b $c>>" -> _out

"-------------------------------------------------------------------------------" -> _out
map [Text : Int] <- [
	"a" : 1
	"b" : 2
	"c" : 3
]
"iterating map: $map" -> _out

"...with _ " -> _out
for _ in map do "_" -> _out

"...with key " -> _out
for k in map do k -> _out

"...with key : _" -> _out
for k : _ in map do "$k : _" -> _out

"...with _ : value" -> _out
for _ : v in map do "_ : $v" -> _out

"...with key : value" -> _out
for k : v in map do "$k : $v" -> _out

"...with key typed : value typed" -> _out
for k Text : v Int in map do "$k : $v" -> _out

"-------------------------------------------------------------------------------" -> _out
mapWithStructValue [Text : Foo] <- [
	"a" : Foo.<1,   2,   3>,
	"b" : Foo.<10,  20,  30>,
	"c" : Foo.<100, 200, 300>
]
"iterating map of value Struct: $mapWithStructValue" -> _out

"...with k : <a b c>" -> _out
for k : <a, b, c> in mapWithStructValue do "$k : <$a $b $c>" -> _out

"...with k : v <a b c>" -> _out
for k : v <a, b, c> in mapWithStructValue do "$k : $v <$a $b $c>" -> _out

"-------------------------------------------------------------------------------" -> _out
mapWithStructKey [Foo : Int] <- [
	Foo.<1,   2,   3>   : 4,
	Foo.<10,  20,  30>  : 40,
	Foo.<100, 200, 300> : 400
]
"iterating map of key Struct: $mapWithStructKey" -> _out

"...with <a b c> : v" -> _out
for <a, b, c> : v in mapWithStructKey do "<$a $b $c> : $v" -> _out

"...with <a b c> : v" -> _out
for k <a, b, c> : v in mapWithStructKey do "$k <$a $b $c> : $v" -> _out

"-------------------------------------------------------------------------------" -> _out
mapWithStructPair [Foo : Bar] <- [
	Foo.<1,   2,   3>   : Bar.<4,   5,   Foo.<6,   7,   8>>,
	Foo.<10,  20,  30>  : Bar.<40,  50,  Foo.<60,  70,  80>>,
	Foo.<100, 200, 300> : Bar.<400, 500, Foo.<600, 700, 800>>,
]
"iterating map of pair Struct: $mapWithStructPair" -> _out

"...with <a b c> : <x y z>" -> _out
for <a, b, c> : <x, y, z> in mapWithStructPair do "<$a $b $c> : <$x $y $z>" -> _out

"...with k <a b c> : v <x y z>" -> _out
for k <a, b, c> : v <x, y, z> in mapWithStructPair do "$k <$a $b $c> : $v <$x $y $z>" -> _out

"-------------------------------------------------------------------------------" -> _out
mapWithMapValue [Text : [Text : Int]] <- [
	"a" : ["x":1   "y":2   "z":3]
	"b" : ["x":10  "y":20  "z":30]
	"c" : ["x":100 "y":200 "z":300]
]
"iterating map with value map: $mapWithMapValue" -> _out
"...with k : [k2 : v]" -> _out
for k : [k2 : v] in mapWithMapValue do "$k : $k2 : $v" -> _out

"-------------------------------------------------------------------------------" -> _out
mapWithMapKey [[Text : Int] : Text] <- [
	["x":1   "y":2   "z":3]   : "a"
	["x":10  "y":20  "z":30]  : "b"
	["x":100 "y":200 "z":300] : "c"
]
"iterating map with key map: $mapWithMapKey" -> _out
"...with k : v : k2" -> _out
"THIS SHOULD FAIL (for now)" -> _out
for k : v : k2 in mapWithMapKey do "$k : $v : $k2" -> _out

