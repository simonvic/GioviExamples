# GioviSpecs 0.37


#? When enabled, ansi escape codes will be used to redraw the output
constant REDRAW Bool <- true

esc Text <- "\u001B"
ansiMove(column Int, line Int)  { \out +<- "$esc[$line;${column}H"}
ansiErase(mode Int)             { \out +<- "$esc[${mode}J"}

#? Directions
constant R Text <- "R"
constant L Text <- "L"
constant S Text <- "S"

#? Describe the transition between TM states
Transition <
	#? Value to write on tape
	output Text

	#? Move direction
	direction Text

	#? Label of the state after transitioning
	newStateLabel Text
>

#? A TM state
State <
	label Text

	#? Exiting edges from the state based on the input mapped to a transition
	#           input : transition
	transitions [Text : Transition]
>

#? Turing machine
Machine <
	#? States mapped by their label
	states [Text : State]
>

#? Current configuration of the machine
Configuration <
	#? Current representation of the tape
	tape [Text]

	#? Current machine position on the tape
	pointer Int

	#? Position of the first non-significant part of the tape
	nonSignificantPointer Int

	#? Current machine state
	state State
>

#?
# Pretty print of a machine
# @param machine
# @return pretty text
prettyMachine(machine Machine) => Text {
	"=== Machine\n" -> pretty Text
	for label : state in machine.states do {
		"- $label\n" ->+ pretty
		for input : transition in state.transitions do {
			"|--($input -> ${transition.output},${transition.direction})--> ${transition.newStateLabel}\n" ->+ pretty
		}
		"\n" ->+ pretty
	}
	=> pretty
}

#?
# Pretty print of a machine configuration
# @param machine
# @return pretty text
prettyConf(conf Configuration) => Text {
	pretty Text <- "|"
	for t in conf.tape do "$t|" ->+ pretty
	pretty +<- "\n " + "  "^conf.pointer + "^"
	pretty +<- "\n " + "  "^conf.pointer + "${conf.state.label}"
	=> pretty
}

#?
# Perform a computational pass
# @param machine
# @param current configuration
# @return new configuration
produce(machine Machine, conf Configuration) => Configuration {
	# read tape
	input Text
	if conf.pointer >= conf.nonSignificantPointer do {
		"_" ->+ conf.tape
		input <- "_"
	} else {
		input <- conf.tape@{conf.pointer}
	}

	# find transition
	transition Transition
	if conf.state.transitions =~ input do {
		transition <- conf.state.transitions@input
	} else {
		transition <- Transition.<
			output: input,
			direction: S,
			newStateLabel: "reject"
		>
	}


	# update tape
	newTape [Text] <- conf.tape
	newTape@{conf.pointer} <- transition.output

	# move
	newPointer Int <- conf.pointer
	if transition.direction {
		= R do 1 ->+ newPointer
		= L when newPointer >= 1 do 1 ->- newPointer
	}

	newState State <- machine.states@{transition.newStateLabel}
	=> Configuration.<newTape, newPointer, newTape@% , newState>
}

################################################################################

constant STATES_PRESETS [Text : [Text : State]] <- [

	"bitflip" : [
		"initial" : State.<"initial", [
			"0" : <"1" R "initial">,
			"1" : <"0" R "initial">,
			"_" : <"_" L "q1">,
		]>
		"q1" : State.<"q1", [
			"0" : <"0" L "accept">,
			"1" : <"1" L "accept">,
			"_" : <"_" L "accept">,
		]>
		"accept" : State.<label: "accept">,
		"reject" : State.<label: "reject">,
	],

	#?
	# f(x, y) = x + y; x,y € N0;
	# input: w0z; w,z base 1 representation of x and y
	# output: wz0
	"unary_sum" : [
		"initial" : State.<"initial", [
			"1" : <"_" R "q1">,
		]>
		"q1" : State.<"q1", [
			"1" : <"1" R "q1">,
			"0" : <"1" R "q2">,
		]>
		"q2" : State.<"q2", [
			"1" : <"1" R "q2">,
			"_" : <"_" L "q3">,
		]>
		"q3" : State.<"q3", [
			"1" : <"0" L "q4">,
		]>
		"q4" : State.<"q4", [
			"1" : <"1" L "q4">,
			"_" : <"1" R "q5">,
		]>
		"q5" : State.<"q5", [
			"1" : <"1" L "accept">,
			"0" : <"0" L "accept">,
		]>
		"accept" : State.<label: "accept">,
		"reject" : State.<label: "reject">,
	]

	#?
	# f(x, y) = x - y; x,y € N0; x >= y
	# input: w0z; w,z base 1 representation of x and y
	# output: wz0
	"unary_dif" : [
		"initial" : State.<"initial", [
			"0" : <"0" R "initial">,
			"1" : <"1" R "initial">,
			"_" : <"_" L "b">,
		]>
		"b" : State.<"b", [
			"0" : <"0" L "accept">,
			"1" : <"_" L "c">,
		]>
		"c" : State.<"c", [
			"1" : <"1" L "c">,
			"0" : <"0" L "d">,
		]>
		"d" : State.<"d", [
			"0" : <"0" L "d">,
			"1" : <"0" L "initial">,
		]>
		"accept" : State.<label: "accept">,
		"reject" : State.<label: "reject">,
	]

	#? Right bitshift
	"bitshift_right" : [
		"initial" : State.<"initial", [
			"0" : <"0" R "initial">,
			"1" : <"1" R "initial">,
			"_" : <"_" L "b">,
		]>
		"b" : State.<"b", [
			"0" : <"_" R "c">,
			"1" : <"_" R "d">,
			"_" : <"0" L "accept">,
		]>
		"c" : State.<"c", [
			"_" : <"0" L "e">,
		]>
		"d" : State.<"d", [
			"_" : <"1" L "e">,
		]>
		"e" : State.<"e", [
			"_" : <"_" L "b">,
		]>
		"accept" : State.<label: "accept">,
		"reject" : State.<label: "reject">,
	]

	#? Increase by one
	"bit_increment" : [
		"initial" : State.<"initial", [
			"0" : <"0" R "initial">,
			"1" : <"1" R "initial">,
			"_" : <"_" L "b">,
		]>
		"b" : State.<"b", [
			"1" : <"1" L "b">,
			"0" : <"1" R "c">,
		]>
		"c" : State.<"c", [
			"0" : <"0" R "c">,
			"1" : <"0" R "c">,
			"_" : <"_" L "accept">,
		]>
		"accept" : State.<label: "accept">,
		"reject" : State.<label: "reject">,
	]

	#? Indefinitely increase by one
	"bit_counter" : [
		"initial" : State.<"initial", [
			"0" : <"0" R "initial">,
			"1" : <"1" R "initial">,
			"_" : <"_" L "b">,
		]>
		"b" : State.<"b", [
			"1" : <"1" L "b">,
			"0" : <"1" R "c">,
		]>
		"c" : State.<"c", [
			"0" : <"0" R "c">,
			"1" : <"0" R "c">,
			"_" : <"_" L "b">,
		]>
		"accept" : State.<label: "accept">,
		"reject" : State.<label: "reject">,
	]


]

machine Machine <- Machine.<states: STATES_PRESETS@"bit_increment">

tape [Text] <- "1010101" / ""
configuration Configuration <- Configuration.<tape, 0, tape@% , machine.states@"initial">

prettyMachine(machine) -> \out
"=== Computing" -> \out
prettyConf(configuration) -> \out
repeat {
	if REDRAW do {
		ansiErase(2)
		ansiMove(0, 0)
	}
	produce(machine, configuration) -> configuration
	"" -> \out
	prettyConf(configuration) -> \out
	if configuration.state.label {
		= "accept" do {
			"accepted" -> \out
			break
		}
		= "reject" do {
			"rejected" -> \out
			break
		}
	}
}
