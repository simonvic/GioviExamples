"Welcome to Konway's game of life implementation in Giovi!" -> \out
"Choose a preset:" -> \out
for preset in PRESETS@@ do {
	"\t- $preset" -> \out
	toBraille(PRESETS@preset) -> \out
}

preset Text
repeat {
	"> " ->+ \out
	\in -> preset
	if PRESETS =~ preset do break
	"Sorry, the preset $preset is not available. Choose another" -> \out
}

state [[Int]] <- PRESETS@preset

for i in 0..1000 do {
	"-" * 80 ->+ \out
	"Gen: #$i" -> \out
	toText(state) -> \out
	update(state) -> state
}
