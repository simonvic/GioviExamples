# GioviSpecs 0.56

import giovi.util.Thread as Thread

"Insert space separated words: " ->+ _out
_in -> line Text
for i in 3..1 do {
	"Get ready in $i...\r" ->+ _out
	Thread.sleep(1000)
}
"" -> _out
line / " " -> words [Text]
correct Int <- 0
for word in words do {
	"$word\r" ->+ _out
	_in -> input Text
	if input = word
		do correct +<- 1
		else "> $input\tWRONG ($word)" -> _out
}

"Result: ($correct / ${words._count}) ${correct / words._count * 100}%" -> _out
