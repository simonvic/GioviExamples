# GioviSpecs 0.31.1

#?{
# Recursive fibonacci.
# @param n = value of fibonacci to find
# @return fibonacci sequence at n
}#
fibonacci(n Int) => Int {
	if n <= 2 do => 1
	=> fibonacci(n - 1) + fibonacci(n - 2)
}

#?{
# Compute fibonacci with the golden ratio
# @param n = value of fibonacci to find
# @return fibonacci sequence at n
}#
fibonacciGoldenRatio(n Int) => Int {
	sqrt5 Real <- 5^{1/2}
	goldenRatio Real <- {1 + sqrt5} / 2
	conjugate Real <- - 1 / goldenRatio
	=> {{goldenRatio^n - conjugate^n} / sqrt5} as Int
}

#?{
# Iterative bottom-up fibonacci
# @param n = value of fibonacci to find
# @return fibonacci of sequence at n
}#
fibonacciBottomUp(n Int) => Int {
	if n = 0 | n = 1 do => n
	cache [Int] <- [1 1]
	for i in 2..n do {
		cache@{i - 2} + cache@{i - 1} ->+ cache
	}
	=> cache@{n - 1}
}

#?{
# Iterative fibonacci with memoization via associative array
# @param n = value of fibonacci to find
# @return fibonacci sequence at n
}#
fibonacciAssociativeMemoIter(n Int) => Int {
	cache [Int : Int] <- [ 1:1 2:1 ]
	for i in 3..n do {
		cache +<- [ i : cache@{i - 1} + cache@{i - 2} ]
	}
	=> cache@n;
}

#?{
# Iterative fibonacci with memoization via array
# @param n = value of fibonacci to find
# @return fibonacci sequence at n
}#
fibonacciMemoIter(n Int) => Int {
	cache [Int] <- [1 1]
	# NOTE: arrays indexes are 0-based
	for i in 2..n-1 do {
		cache +<- cache@{i - 1} + cache@{i - 2}
	}
	=> cache@{n - 1};
}

#?{
# Iterative fibonacci with better space complexity
# @param n = value of fibonacci to find
# @return fibonacci sequence at n
}#
fibonacciBottomUpBetterSpace(n Int) => Int {
	if n <= 1 do => n
	x Int <- 0
	y Int <- 1
	for i in 2..n do {
		temp Int <- x + y
		x <- y
		y <- temp
	}
	=> y
}

"Insert iteration count: " ->+ \out
\in as Int -> n Int
"Fibonacci of $n will be computed" -> \out
algorithm Text
repeat {
	"{
	Select algorithm:
		0) to exit
		1) recursive
		2) iterative (bottom-up)
		3) iterative (memoization via associative array)
		4) iterative (memoization via array)
		5) golden ratio
		6) bottom up improved space
	> }" ->+ \out
	\in -> algorithm Text
	if algorithm {
		= "0" do break;
		= "1" do "fibonacci($n) => ${fibonacci(n)}" -> \out
		= "2" do "fibonacciBottomUp($n) => ${fibonacciBottomUp(n)}" -> \out
		= "3" do "fibonacciAssociativeMemoIter($n) => ${fibonacciAssociativeMemoIter(n)}"  -> \out
		= "4" do "fibonacciMemoIter($n) => ${fibonacciMemoIter(n)}" -> \out
		= "5" do "fibonacciGoldenRatio($n) => ${fibonacciGoldenRatio(n)}" -> \out
		= "6" do "fibonacciBottomUpBetterSpace($n) => ${fibonacciBottomUpBetterSpace(n)}" -> \out
	} else default -> algorithm 
	if algorithm != default do break
	"Invalid algorithm" -> \out
}
