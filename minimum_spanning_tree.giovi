const INF Int <- 99999999

# TODO: actually implement priority queue

#? Extract the minimum from a (fake) priority queue
#? @param queue
#? @return minimum edge
extractMin(queue [Text => Int]) => Text {
	min Text <- queue._keys.0
	for u => cost in queue do {
		if cost < queue.{min} do min <- u
	}
	if min != default do {
		queue -<- min
	}
	=> min
}

#? Print graph
#? @param graph (adjacency list)
printGraph(graph [Text => [Text => Int]]) {
	"Edges: $graph" -> _out
	for u => edges in graph do {
		for v => cost in edges do {
			"$u <--$cost--> $v" -> _out
		}
		"" -> _out
	}
}

#? Print MST
#? @param mst child => parent
printMST(mst [Text => Text]) {
	"MST: " -> _out
	mstCost Int
	for child => parent in mst do {
		if parent = "" do {
			child -> _out
		} else {
			"$parent <--${graph.{parent}.{child}}--> $child" -> _out
			graph.{parent}.{child} ->+ mstCost
		}
	}
	"cost: $mstCost" -> _out
}

#? Prim's greedy algorithm to find MST (Minimum Spanning Tree)
#? by holding unexplored nodes in a priority queue with cost to reach it as key;
#? while queue is not empty, find cheapest edge and add it to the MST
#? @param graph (adjacency list)
#? @return mst child => parent
prim(graph [Text => [Text => Int]]) => [Text => Text] {

	# (Fake) priority queue, with cost as key
	queue [Text => Int]
	# init queue with infinite cost
	for u => edges in graph do queue +<- [u => INF]

	# List of explored nodes
	explored [Text]

	# MST represented with child=>parent map
	mst [Text => Text]
	# init mst with all orphans
	for u in graph do [u => ""] ->+ mst

	repeat if queue._count != 0 {
		"\nqueue: $queue" -> _out

		# Extract vertex with minimum cost from the queue
		extractMin(queue) -> min Text
		min ->- queue
		min ->+ explored

		graph.{min} -> exitingEdgesFromMin [Text => Int]

		# Print exiting edges
		"min: $min" -> _out
		for v in exitingEdgesFromMin do {
			if v ~= explored do skip
			"\t<--${exitingEdgesFromMin.{v}}--> $v" -> _out
		}

		for v => cost in exitingEdgesFromMin do {
			if v ~= explored do skip
			if cost < queue.{v} do {
				[v => cost] ->+ queue
				mst.{v} <- min
			}
		}
	}
	"\nExplored $explored" -> _out
	=> mst
}

# Kruskall
makeSingletonComponents(graph [Text => [Text => Int]]) => [[Text]] {
	components [[Text]]
	for u in graph do [u] ->+ components
	#for u => [v => edges] in graph do {
	#	if [u] ~= components do skip
	#	[[u]] ->+ components
	#}
	=> components
}

getEdgesOrderedByIncreasingCost(graph [Text => [Text => Int]]) => [[Text]] {
	#"Ordering $graph" -> _out
	edges [Text => [Text => Int]]
	for u => [v => cost] in graph do {
		if v in edges do skip
		found Bool
		for o => [w => _] in edges do {
			if u = o and v in w do {
				found <- true
				break
			}
		}
		if found do skip
		if u in edges do {
			[v => cost] ->+ edges.{u}
		} else {
			[u => [v => cost]] ->+ edges
		}
	}
	"unique $edges" -> _out
	sorted [[Text ** 2]]
	repeat if edges._count != 0 do {
		minCost Int <- INF
		minEdge [Text ** 2]
		for u => [v => cost] in edges do {
			if cost < minCost do {
				cost -> minCost
				[u v] -> minEdge
			}
		}
		if minEdge = ["" ""] do break
		[minEdge.0 minEdge.1] ->+ sorted
		minEdge.1 ->- edges.{minEdge.0}
		sorted -> _out
	}
	=> sorted

	# Old
	#for u => edge in graph do {
	#	for v => cost in edge do {
	#		if edges =~ u & edges.{u} =~ v & cost < edges.{u}.{v} do {
	#			cost -> edges.{u}.{v}
	#		} else if edges =~ v & edges.{v} =~ u & cost < edges.{v}.{u} do {
	#			cost -> edges.{v}.{u}
	#		} else {
	#			[u => [v => cost]] ->+ edges
	#		}
	#	}
	#}
	#t [Text => Text]
	#for u => edge in edges do {
	#	for v in edge do {
	#		[u => v] ->+ t
	#	}
	#}
	#=> t
}

findComponent(u Text, components [[Text]]) => [Text] {
	for component in components do {
		if component =~ u do => component
	}
}

mergeComponents(u Text, v Text, components [[Text]]) => [[Text]] {
	merged [[Text]]
	findComponent(u, components) -> uComponent [Text]
	findComponent(v, components) -> vComponent [Text]
	for component in components do {
		if component = uComponent | component = vComponent do skip
		[component] ->+ merged
	}
	uComponent ->+ vComponent
	[vComponent] ->+ merged
	=> merged
}

kruskall(graph [Text => [Text => Int]]) => [Text => Text] {
	getEdgesOrderedByIncreasingCost(graph) -> edges [[Text]]

	makeSingletonComponents(graph) -> components [[Text]]
	"components $components" -> _out
	mst [Text => Text]
	for edge in edges do {
		u Text <- edge.0
		v Text <- edge.1
		# if they're in the same connected component, adding the edge would
		# cause a cycle
		if findComponent(u, components) = findComponent(v, components) do skip
		[u => v] ->+ mst
		mergeComponents(u, v, components) -> components
		"components: $components" -> _out
	}
	=> mst
}

# Graph represented via adjacency list
# u => [v => cost]
graph [Text => [Text => Int]] <- [
	"a" => ["b"=>5 "e"=>3]
	"b" => ["a"=>5 "c"=>1 "d"=>9 "f"=>2]
	"c" => ["b"=>1 "e"=>6]
	"d" => ["b"=>9 "e"=>7]
	"e" => ["a"=>3 "c"=>6 "d"=>7 "f"=>8]
	"f" => ["b"=>2 "e"=>8]
]

printGraph(graph)
repeat {
	"{
	------------------
	Select algorithm:
		0) to exit
		1) Prim
		2) Kruskall
	> }" ->+ _out
	_in -> algorithm Text
	mst [Text => Text]
	if algorithm {
		= "0" do break;
		= "1" do prim(graph) -> mst
		= "2" do kruskall(graph) -> mst
	} else default -> algorithm 
	if algorithm = default do {
		"Invalid algorithm" -> _out
	} else {
		"------------------" -> _out
		printMST(mst)
	}
}
