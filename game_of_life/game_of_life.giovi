################################################################################

"Welcome to Conway's game of life implementation in Giovi!" -> _out
"Choose a preset:" -> _out
for presetName => preset in PRESETS do {
	"$presetName" -> _out
	toBraille(preset) -> _out
}

presetName Text
repeat {
	"> " ->+ _out
	_in -> presetName
	if presetName in PRESETS do break
	"Sorry, the preset $presetName is not available. Choose another" -> _out
}
currentGen [[Int]] <- PRESETS.{presetName}

i Int
if REDRAW do Ansi.erase(2) ->+ _out
repeat {
	if REDRAW do Ansi.moveTo(0, 0) ->+ _out
	"-"^80 ->+ _out
	"Generation: #$i" -> _out
	toText(currentGen) -> _out
	update(currentGen) -> nextGen [[Int]]
	if nextGen = currentGen do {
		"Life has stabilized after $i generations" -> _out
		break
	}
	currentGen <- nextGen
	i +<- 1
}
